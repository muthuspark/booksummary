{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ site.Title }}{{ if not .IsHome }}: {{ .Title }}{{ end }}</title>
<link>{{ .Permalink }}</link><description>{{ .Description | default site.Params.description }}</description><language>{{ site.Language.Locale }}</language>
{{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
{{ $pages := .RegularPagesRecursive.ByTitle }}{{ if .IsHome }}{{ $pages = (where site.RegularPages "Section" "posts").ByTitle }}{{ end }}
{{ range first site.Config.Services.RSS.Limit $pages }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid isPermaLink="true">{{ .Permalink }}</guid><description>{{ .Description }}</description>{{ range .Params.categories }}<category>{{ . }}</category>{{ end }}{{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}</item>{{ end }}
</channel></rss>
